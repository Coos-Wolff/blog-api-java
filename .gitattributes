# Normalize all text files, LF by default
* text=auto eol=lf

/mvnw text eol=lf
*.cmd text eol=crlf

# Source
*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Binaries
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
