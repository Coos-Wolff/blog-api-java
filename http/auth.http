### Base config: blog-api running locally
# {{baseUrl}} comes from the "local" environment in http/http-client.env.json.
# In IntelliJ, select the "local" environment in the HTTP Client toolbar before running.
# See http/README.md for details on running this suite in the IntelliJ HTTP Client.

##############################################################################
# CONCERN 1: Register — success
# Self-contained: single request, no prior setup needed.
##############################################################################

### Register a brand-new user — expect 201 with empty body
# NOTE: re-running this a second time will return 409 (email already exists) — that's expected.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "register-success@example.com",
  "name": "Register Success",
  "password": "supersecret123"
}

> {%
client.test("Register succeeds, or already exists on a re-run", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

##############################################################################
# CONCERN 2: Register — duplicate email returns 409
# Self-contained: creates the user, then re-creates it with the same email.
##############################################################################

### Ensure this email exists — expect 201 (or 409 if it already exists — both fine)
# This is setup, not the behavior under test: either outcome means the email is now taken.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "dup-check@example.com",
  "name": "Dup User",
  "password": "supersecret123"
}

> {%
client.test("Setup registration returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Second registration with the SAME (now definitely taken) email — expect 409 (email already exists)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "dup-check@example.com",
  "name": "Dup User",
  "password": "supersecret123"
}

> {%
client.test("Duplicate email registration returns 409", function() {
    client.assert(response.status === 409, "Expected 409 but got " + response.status);
});
%}

##############################################################################
# CONCERN 3: Register — validation failure returns 400
# Self-contained: single request with invalid data, no prior setup needed.
##############################################################################

### Invalid body: bad email format, blank name, too-short password — expect 400
# We specifically want 400 (from bean-validation handling), NOT 500 — a 500 here
# would indicate the catch-all Exception handler is shadowing the validation handler.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "name": "",
  "password": "short"
}

> {%
client.test("Invalid register body returns 400, not 500", function() {
    client.assert(response.status === 400, "Expected 400 but got " + response.status);
});
%}

##############################################################################
# CONCERN 4: Login — success
# Self-contained: registers the user first (idempotent-ish — 201 or 409 both fine),
# then logs in with correct credentials.
##############################################################################

### Register the user for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "login-success@example.com",
  "name": "Login Success",
  "password": "supersecret123"
}

> {%
client.test("Register for login-success concern returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in with correct credentials — expect 200 with access_token, refresh_token, token_type, expires_in
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "login-success@example.com",
  "password": "supersecret123"
}

> {%
client.test("Login returns 200 with the full token payload", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.access_token != null, "Expected access_token in response body");
    client.assert(response.body.refresh_token != null, "Expected refresh_token in response body");
    client.assert(response.body.token_type != null, "Expected token_type in response body");
    client.assert(response.body.expires_in != null, "Expected expires_in in response body");
});
%}

##############################################################################
# CONCERN 5: Login — wrong password returns 401
# Self-contained: registers the user first, then attempts login with a bad password.
##############################################################################

### Register the user for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "login-wrong@example.com",
  "name": "Login Wrong",
  "password": "supersecret123"
}

> {%
client.test("Register for login-wrong concern returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in with an incorrect password — expect 401
# NOTE: AuthService.login() catches the AuthenticationException from the AuthenticationManager
# and rethrows InvalidCredentialsException, which GlobalExceptionHandler maps to a 401
# ProblemDetail body ({"detail":"Invalid credentials",...}).
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "login-wrong@example.com",
  "password": "totally-wrong-password"
}

> {%
client.test("Wrong password returns 401 with a uniform 'Invalid credentials' detail", function() {
    client.assert(response.status === 401, "Expected 401 but got " + response.status);
    client.assert(response.body.detail === "Invalid credentials",
        "Expected detail 'Invalid credentials' but got " + response.body.detail);
});
%}

##############################################################################
# CONCERN 6: Refresh — success
# Self-contained: registers, logs in (capturing the response), then refreshes
# using the captured refresh_token.
##############################################################################

### Register the user for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "refresh-success@example.com",
  "name": "Refresh Success",
  "password": "supersecret123"
}

> {%
client.test("Register for refresh-success concern returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in to obtain a refresh token — expect 200
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "refresh-success@example.com",
  "password": "supersecret123"
}

> {%
client.test("Login for refresh-success concern returns 200 with a refresh_token", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.refresh_token != null, "Expected refresh_token in response body");
});
%}

### Refresh using the refresh_token from the login above — expect 200 with a new access_token
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{login.response.body.refresh_token}}"
}

> {%
client.test("Refresh with a valid refresh_token returns 200 with a new access_token", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.access_token != null, "Expected access_token in response body");
});
%}

##############################################################################
# CONCERN 7: Refresh — access token used as refresh returns 401
# Self-contained: registers, logs in (capturing the response), then deliberately
# calls refresh with the ACCESS token instead of the refresh token.
##############################################################################

### Register the user for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "refresh-misuse@example.com",
  "name": "Refresh Misuse",
  "password": "supersecret123"
}

> {%
client.test("Register for refresh-misuse concern returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in to obtain an access token — expect 200
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "refresh-misuse@example.com",
  "password": "supersecret123"
}

> {%
client.test("Login for refresh-misuse concern returns 200 with an access_token", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.access_token != null, "Expected access_token in response body");
});
%}

### Attempt to refresh using the ACCESS token (not the refresh token) — expect 401
# This verifies the server checks token_type == "refresh" and rejects access tokens here.
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{login.response.body.access_token}}"
}

> {%
client.test("Refresh with an access token instead of a refresh token returns 401", function() {
    client.assert(response.status === 401, "Expected 401 but got " + response.status);
});
%}

##############################################################################
# CONCERN 8: Refresh — malformed token returns 401
# Standalone: no login needed, decoding fails outright.
##############################################################################

### Refresh with a malformed/garbage token — expect 401
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refresh_token": "not.a.real.token"
}

> {%
client.test("Refresh with a malformed token returns 401", function() {
    client.assert(response.status === 401, "Expected 401 but got " + response.status);
});
%}