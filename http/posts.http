### Base config: blog-api running locally
# {{baseUrl}} comes from the "local" environment in http/http-client.env.json.
# In IntelliJ, select the "local" environment in the HTTP Client toolbar before running.
# See http/README.md for details on running this suite in the IntelliJ HTTP Client.

##############################################################################
# NOTE: admin-override coverage
# The admin-can-edit/delete-any-post path is NOT exercised in this file.
# Users created via /api/auth/register are always non-admin, so testing the
# admin path requires manually promoting a user to admin in the database.
# That path is covered by unit tests and will be covered by future
# integration tests.
##############################################################################

##############################################################################
# CONCERN 1: Public read — list (no token)
# Self-contained: single request, no prior setup needed.
##############################################################################

### List posts with no Authorization header — expect 200
GET {{baseUrl}}/api/posts?page=0&size=20&sort=date,desc

> {%
client.test("Public list returns 200", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
});
%}

##############################################################################
# CONCERN 2: Public read — get one not found (no token)
# Self-contained: single request against a random UUID, no prior setup needed.
##############################################################################

### Get a post that doesn't exist, with no token — expect 404 (ProblemDetail)
GET {{baseUrl}}/api/posts/00000000-0000-0000-0000-000000000000

> {%
client.test("Public get-one for a missing post returns 404", function() {
    client.assert(response.status === 404, "Expected 404 but got " + response.status);
});
%}

##############################################################################
# CONCERN 3: Create requires authentication
# Self-contained: single request with a valid body but no Authorization header.
##############################################################################

### Create a post with no Authorization header — expect 401
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "title": "Unauthenticated Create Attempt",
  "subtitle": "Should be rejected",
  "body": "This request has no bearer token and must be rejected.",
  "img_url": "https://example.com/img/unauth.png"
}

> {%
client.test("Create without a token returns 401", function() {
    client.assert(response.status === 401, "Expected 401 but got " + response.status);
});
%}

##############################################################################
# CONCERN 4: Create then get (happy path, as owner)
# Self-contained: registers, logs in, creates a post, then reads it back
# with no token to confirm reads are public and the author comes from the token.
##############################################################################

### Register the user for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "posts-owner@example.com",
  "name": "Posts Owner",
  "password": "supersecret123"
}

> {%
client.test("Register for posts-owner concern returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in to obtain an access token — expect 200
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "posts-owner@example.com",
  "password": "supersecret123"
}

> {%
client.test("Login for posts-owner concern returns 200 with an access_token", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.access_token != null, "Expected access_token in response body");
});
%}

### Create a post as the logged-in owner — expect 201 with a Location header and the created body
# @name createPost
POST {{baseUrl}}/api/posts
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "title": "Happy Path Post",
  "subtitle": "Created via the HTTP client",
  "body": "This post verifies the full create-then-get happy path.",
  "img_url": "https://example.com/img/happy-path.png"
}

> {%
client.test("Create returns 201 with a Location header and the created body", function() {
    client.assert(response.status === 201, "Expected 201 but got " + response.status);
    client.assert(response.headers.valueOf("Location") != null, "Expected a Location header");
    client.assert(response.body.id != null, "Expected id in response body");
    client.assert(response.body.title === "Happy Path Post", "Expected title to echo the request body");
    client.assert(response.body.author != null && response.body.author.id != null,
        "Expected author.id populated from the token");
});
%}

### Get the created post by id, with NO token — expect 200 with matching content and author populated from the token
GET {{baseUrl}}/api/posts/{{createPost.response.body.id}}

> {%
client.test("Public get-one after create returns 200 with matching content", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.id != null, "Expected id in response body");
    client.assert(response.body.title === "Happy Path Post", "Expected title to match the created post");
    client.assert(response.body.author != null && response.body.author.name != null,
        "Expected author populated from the token");
});
%}

