##############################################################################
# CONCERN 6: Owner can patch own post
# Self-contained: registers, logs in, creates a post, then patches only the
# title and asserts the other fields are left unchanged.
##############################################################################

### Register the user for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "posts-owner2@example.com",
  "name": "Posts Owner Two",
  "password": "supersecret123"
}

> {%
client.test("Register for posts-owner2 concern returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in to obtain an access token — expect 200
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "posts-owner2@example.com",
  "password": "supersecret123"
}

> {%
client.test("Login for posts-owner2 concern returns 200 with an access_token", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.access_token != null, "Expected access_token in response body");
});
%}

### Create a post to patch afterward — expect 201
# @name createPost
POST {{baseUrl}}/api/posts
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "title": "Original Title",
  "subtitle": "Original Subtitle",
  "body": "Original body content.",
  "img_url": "https://example.com/img/original.png"
}

> {%
client.test("Create for posts-owner2 concern returns 201 with an id", function() {
    client.assert(response.status === 201, "Expected 201 but got " + response.status);
    client.assert(response.body.id != null, "Expected id in response body");
});
%}

### Patch only the title as the owner — expect 200 with the new title and unchanged subtitle/body/img_url
PATCH {{baseUrl}}/api/posts/{{createPost.response.body.id}}
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "title": "Updated Title"
}

> {%
client.test("Partial patch updates only the title, leaving other fields unchanged", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.title === "Updated Title", "Expected title to be updated");
    client.assert(response.body.subtitle === "Original Subtitle", "Expected subtitle to be unchanged");
    client.assert(response.body.body === "Original body content.", "Expected body to be unchanged");
    client.assert(response.body.img_url === "https://example.com/img/original.png",
        "Expected img_url to be unchanged");
});
%}

##############################################################################
# CONCERN 7: Owner can delete own post
# Self-contained: registers, logs in, creates a post, then deletes it and
# confirms it's gone.
##############################################################################

### Register the user for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "posts-owner3@example.com",
  "name": "Posts Owner Three",
  "password": "supersecret123"
}

> {%
client.test("Register for posts-owner3 concern returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in to obtain an access token — expect 200
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "posts-owner3@example.com",
  "password": "supersecret123"
}

> {%
client.test("Login for posts-owner3 concern returns 200 with an access_token", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.access_token != null, "Expected access_token in response body");
});
%}

### Create a post to delete afterward — expect 201
# @name createPost
POST {{baseUrl}}/api/posts
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "title": "Post To Delete",
  "subtitle": "Will be removed",
  "body": "This post will be deleted by its owner.",
  "img_url": "https://example.com/img/to-delete.png"
}

> {%
client.test("Create for posts-owner3 concern returns 201 with an id", function() {
    client.assert(response.status === 201, "Expected 201 but got " + response.status);
    client.assert(response.body.id != null, "Expected id in response body");
});
%}

### Delete the post as its owner — expect 204
DELETE {{baseUrl}}/api/posts/{{createPost.response.body.id}}
Authorization: Bearer {{login.response.body.access_token}}

> {%
client.test("Owner delete returns 204", function() {
    client.assert(response.status === 204, "Expected 204 but got " + response.status);
});
%}

### Confirm the post is gone, with no token — expect 404
GET {{baseUrl}}/api/posts/{{createPost.response.body.id}}

> {%
client.test("Getting the deleted post returns 404", function() {
    client.assert(response.status === 404, "Expected 404 but got " + response.status);
});
%}

##############################################################################
# CONCERN 8: Non-owner cannot patch (403)
# Self-contained: two users — A creates a post, B (a different user) attempts
# to patch it and must be rejected.
##############################################################################

### Register user A for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "posts-ownerA@example.com",
  "name": "Posts Owner A",
  "password": "supersecret123"
}

> {%
client.test("Register user A returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in as user A — expect 200
# @name loginA
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "posts-ownerA@example.com",
  "password": "supersecret123"
}

> {%
client.test("Login as user A returns 200 with an access_token", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.access_token != null, "Expected access_token in response body");
});
%}

### Create a post as user A — expect 201
# @name createPost
POST {{baseUrl}}/api/posts
Authorization: Bearer {{loginA.response.body.access_token}}
Content-Type: application/json

{
  "title": "User A's Post",
  "subtitle": "Owned by A",
  "body": "Only A (or an admin) should be able to modify this post.",
  "img_url": "https://example.com/img/owned-by-a.png"
}

> {%
client.test("Create as user A returns 201 with an id", function() {
    client.assert(response.status === 201, "Expected 201 but got " + response.status);
    client.assert(response.body.id != null, "Expected id in response body");
});
%}

### Register user B for this concern — expect 201 (or 409 if it already exists — both fine)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "posts-userB@example.com",
  "name": "Posts User B",
  "password": "supersecret123"
}

> {%
client.test("Register user B returns 201 or 409", function() {
    client.assert(response.status === 201 || response.status === 409,
        "Expected 201 or 409 but got " + response.status);
});
%}

### Log in as user B — expect 200
# @name loginB
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "posts-userB@example.com",
  "password": "supersecret123"
}

> {%
client.test("Login as user B returns 200 with an access_token", function() {
    client.assert(response.status === 200, "Expected 200 but got " + response.status);
    client.assert(response.body.access_token != null, "Expected access_token in response body");
});
%}

### User B attempts to patch A's post — expect 403 (ProblemDetail)
PATCH {{baseUrl}}/api/posts/{{createPost.response.body.id}}
Authorization: Bearer {{loginB.response.body.access_token}}
Content-Type: application/json

{
  "title": "Hijacked Title"
}

> {%
client.test("Non-owner patch attempt returns 403", function() {
    client.assert(response.status === 403, "Expected 403 but got " + response.status);
});
%}

